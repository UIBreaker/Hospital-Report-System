{
  "name": "hospital-report-system",
  "version": "1.6.0",
  "description": "Hệ thống Báo cáo Giao ban - Bệnh viện Đa khoa Khu vực Bình Long",
  "main": "api/index.js",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "cd server && node server.js",
    "test": "playwright test",
    "test:db": "playwright test tests/db-stats.spec.js --project=chromium-desktop",
    "test:all": "playwright test tests/all-accounts.spec.js --project=chromium-desktop",
    "test:all:full": "playwright test tests/all-accounts.spec.js",
    "test:deep": "playwright test tests/deep-testing.spec.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "router": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
